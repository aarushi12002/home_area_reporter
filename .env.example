# Optional: higher Socrata API limits. Keep server-side.
SOCRATA_APP_TOKEN=

# Optional HowLoud Soundscore free partner key. Server-side only; no caching.
HOWLOUD_API_KEY=

# Local PostgreSQL or Neon pooled connection string. Keep credentials server-side.
DATABASE_URL=postgresql://localhost/home_area_reporter

# Required only for a deployed scheduled ingestion route. Use 16+ random characters.
CRON_SECRET=

# Public browser tile template and required attribution. The default OSM tile
# service is suitable only for low-volume local development; configure a
# production-capable provider before deployment.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Optional website-only GA4 overrides. Public default: G-4R4PJRD22N.
# The example disables collection. Production without overrides uses the configured
# default only on the exact live host after visitor opt-in. Keep Enhanced Measurement off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_ENABLED=false

# Free Census key for optional bulk national ACS imports; server-side only.
CENSUS_API_KEY=

# Confirm against the database provider account; pause expansion at 80%.
DATABASE_STORAGE_LIMIT_BYTES=1000000000
