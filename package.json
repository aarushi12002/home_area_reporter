    "db:migrate": "node scripts/db-migrate.mjs",
    "db:ingest": "node scripts/ingest.mjs",
    "db:setup": "npm run db:migrate"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
